      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;height:2.75rem;padding:0 1rem;border:1px solid transparent;border-radius:.75rem;font-family:system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:.875rem;line-height:1.4285714286;font-weight:500;white-space:nowrap;cursor:pointer;transition:all 150ms cubic-bezier(.4,0,.2,1);background:var(--secondary, #f2e6dc);color:var(--secondary-foreground, #4d3b31);}.ds-button-secondary:hover{background:color-mix(in oklch,var(--secondary, #f2e6dc),var(--foreground, #342b27) 5%);}.ds-button-secondary:focus-visible{outline:none;border-color:var(--ring, #873e4a);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring, #873e4a) 50%,transparent);}.ds-button-secondary:active{transform:translateY(1px)}.ds-button-secondary:disabled{pointer-events:none;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition-duration:0s}}"
