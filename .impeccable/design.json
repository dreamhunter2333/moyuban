      "css": ".ds-badge{display:inline-flex;align-items:center;justify-content:center;height:1.25rem;padding:.125rem .5rem;border:1px solid var(--border, #e0d3c8);border-radius:2rem;background:transparent;color:var(--foreground, #342b27);font-family:system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:.75rem;line-height:1.3333333333;font-weight:500;white-space:nowrap}@media(prefers-reduced-motion:reduce){.ds-badge{transition-duration:0s}}"
