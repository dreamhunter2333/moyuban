    {
      "name": "字段",
      "kind": "input",
      "refersTo": "input",
      "description": "手机 16px、桌面 14px，焦点、错误与禁用共用语义色。",
      "html": "<input class=\"ds-input\" aria-label=\"发薪日（每月）\" placeholder=\"0–28\" />",
      "css": ".ds-input{height:2.75rem;width:100%;min-width:0;padding:.5rem .75rem;border:1px solid var(--input, #978376);border-radius:.75rem;background:transparent;color:var(--foreground, #342b27);font-family:system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:1rem;transition:color 150ms cubic-bezier(.4,0,.2,1),border-color 150ms cubic-bezier(.4,0,.2,1)}.ds-input::placeholder{color:var(--muted-foreground, #74675d)}.ds-input:focus-visible{outline:none;border-color:var(--ring, #873e4a);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring, #873e4a) 50%,transparent);}.ds-input:disabled{opacity:.5;cursor:not-allowed;background:color-mix(in srgb,var(--input, #978376) 50%,transparent)}.ds-input[aria-invalid=\"true\"]{border-color:var(--destructive, #b42332);box-shadow:0 0 0 3px color-mix(in srgb,var(--destructive, #b42332) 20%,transparent)}:host-context(.dark) .ds-input{background:color-mix(in srgb,var(--input, #978376) 30%,transparent)}@media(min-width:768px){.ds-input{font-size:.875rem}}@media(prefers-reduced-motion:reduce){.ds-input{transition-duration:0s}}"
    },
    {
      "name": "应用导航",
      "kind": "nav",
      "refersTo": "navigation-link",
      "description": "当前项、悬停项与暖杏色导航表面。",
      "html": "<nav class=\"ds-nav\" aria-label=\"示例导航\"><a href=\"#\" class=\"ds-nav-link\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 2v4m8-4v4M3 10h18\"/><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/></svg>摸鱼日历</a><a href=\"#\" class=\"ds-nav-link\">工具集</a></nav>",
      "css": ".ds-nav{display:grid;gap:.375rem;padding:1rem;background:var(--sidebar, #f1e0d2);font-family:system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif}.ds-nav-link{display:flex;align-items:center;gap:.75rem;min-height:2.75rem;padding:0 .875rem;border-radius:.75rem;color:var(--sidebar-foreground, #514035);font-size:.875rem;font-weight:500;text-decoration:none;transition:all 150ms cubic-bezier(.4,0,.2,1)}.ds-nav-link svg{width:1rem;height:1rem}.ds-nav-link:hover{background:var(--sidebar-accent, #e6cfc0)}.ds-nav-link[aria-current=\"page\"]{background:var(--primary, #873e4a);color:var(--primary-foreground, #fffdf9)}.ds-nav-link:focus-visible{outline:2px solid var(--ring, #873e4a);outline-offset:4px}.ds-nav-link:active{transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-nav-link{transition-duration:0s}}"
