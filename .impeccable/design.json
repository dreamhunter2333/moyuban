      "css": ".ds-input{height:2.75rem;width:100%;min-width:0;padding:.5rem .75rem;border:1px solid var(--input, #968777);border-radius:.75rem;background:transparent;color:var(--foreground, #37312e);font-family:system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:1rem;transition:color 150ms cubic-bezier(.4,0,.2,1),border-color 150ms cubic-bezier(.4,0,.2,1)}.ds-input::placeholder{color:var(--muted-foreground, #756b60)}.ds-input:focus-visible{outline:none;border-color:var(--ring, #1687b3);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring, #1687b3) 50%,transparent);}.ds-input:disabled{opacity:.5;cursor:not-allowed;background:color-mix(in srgb,var(--input, #968777) 50%,transparent)}.ds-input[aria-invalid=\"true\"]{border-color:var(--destructive, #b42332);box-shadow:0 0 0 3px color-mix(in srgb,var(--destructive, #b42332) 20%,transparent)}:host-context(.dark) .ds-input{background:color-mix(in srgb,var(--input, #968777) 30%,transparent)}@media(min-width:768px){.ds-input{font-size:.875rem}}@media(prefers-reduced-motion:reduce){.ds-input{transition-duration:0s}}"
