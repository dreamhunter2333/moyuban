  "components": [
    {
      "name": "主操作",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "实际 shadcn 按钮变体，保留悬停、焦点、按下与禁用状态。",
      "html": "<button class=\"ds-button-primary\">主操作</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;height:2.75rem;padding:0 1rem;border:1px solid transparent;border-radius:.75rem;font-family:system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:.875rem;line-height:1.4285714286;font-weight:500;white-space:nowrap;cursor:pointer;transition:all 150ms cubic-bezier(.4,0,.2,1);background:var(--primary, #873e4a);color:var(--primary-foreground, #fffdf9);}.ds-button-primary:hover{background:color-mix(in srgb,var(--primary, #873e4a) 80%,transparent);}.ds-button-primary:focus-visible{outline:none;border-color:var(--ring, #873e4a);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring, #873e4a) 50%,transparent);}.ds-button-primary:active{transform:translateY(1px)}.ds-button-primary:disabled{pointer-events:none;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition-duration:0s}}"
    },
    {
      "name": "描边操作",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "实际 shadcn 按钮变体，保留悬停、焦点、按下与禁用状态。",
      "html": "<button class=\"ds-button-outline\">描边操作</button>",
      "css": ".ds-button-outline{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;height:2.75rem;padding:0 1rem;border:1px solid transparent;border-radius:.75rem;font-family:system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:.875rem;line-height:1.4285714286;font-weight:500;white-space:nowrap;cursor:pointer;transition:all 150ms cubic-bezier(.4,0,.2,1);background:var(--background, #faf7f2);color:var(--foreground, #342b27);border-color:var(--border, #e0d3c8);}.ds-button-outline:hover{background:var(--muted, #f4eee7);}.ds-button-outline:focus-visible{outline:none;border-color:var(--ring, #873e4a);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring, #873e4a) 50%,transparent);}.ds-button-outline:active{transform:translateY(1px)}.ds-button-outline:disabled{pointer-events:none;opacity:.5}:host-context(.dark) .ds-button-outline{background:color-mix(in srgb,var(--input, #978376) 30%,transparent);border-color:var(--input, #978376)}:host-context(.dark) .ds-button-outline:hover{background:color-mix(in srgb,var(--input, #978376) 50%,transparent)}@media(prefers-reduced-motion:reduce){.ds-button-outline{transition-duration:0s}}"
    },
