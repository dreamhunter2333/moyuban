      "css": ".ds-button-ghost{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;height:2.75rem;padding:0 1rem;border:1px solid transparent;border-radius:.75rem;font-family:system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:.875rem;line-height:1.4285714286;font-weight:500;white-space:nowrap;cursor:pointer;transition:all 150ms cubic-bezier(.4,0,.2,1);background:transparent;color:var(--foreground, #342b27);}.ds-button-ghost:hover{background:var(--muted, #f4eee7);}.ds-button-ghost:focus-visible{outline:none;border-color:var(--ring, #873e4a);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring, #873e4a) 50%,transparent);}.ds-button-ghost:active{transform:translateY(1px)}.ds-button-ghost:disabled{pointer-events:none;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button-ghost{transition-duration:0s}}"
