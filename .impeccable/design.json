      "html": "<nav class=\"ds-nav\" aria-label=\"示例导航\"><a href=\"#\" class=\"ds-nav-link\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 2v4m8-4v4M3 10h18\"/><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/></svg>摸鱼日历</a><a href=\"#\" class=\"ds-nav-link\">工具集</a></nav>",
      "css": ".ds-nav{display:grid;gap:.375rem;padding:1rem;background:var(--sidebar, #e7eee4);font-family:system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif}.ds-nav-link{display:flex;align-items:center;gap:.75rem;min-height:2.75rem;padding:0 .875rem;border-radius:.75rem;color:var(--sidebar-foreground, #355043);font-size:.875rem;font-weight:500;text-decoration:none;transition:all 150ms cubic-bezier(.4,0,.2,1)}.ds-nav-link svg{width:1rem;height:1rem}.ds-nav-link:hover{background:var(--sidebar-accent, #d7e3d6)}.ds-nav-link[aria-current=\"page\"]{background:var(--primary, #205b49);color:var(--primary-foreground, #f8fcf9)}.ds-nav-link:focus-visible{outline:2px solid var(--ring, #205b49);outline-offset:4px}.ds-nav-link:active{transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-nav-link{transition-duration:0s}}"
