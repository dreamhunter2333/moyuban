      "kind": "card",
      "refersTo": "card",
      "description": "单层纸面、轻环边界、无常驻浮起阴影。",
      "html": "<section class=\"ds-card\"><div class=\"ds-card-title\">工作时间设置</div><div class=\"ds-card-content\">调整工作日、工作时间和日薪。</div></section>",
      "css": ".ds-card{display:flex;flex-direction:column;gap:1rem;overflow:hidden;padding:1rem 0;border-radius:1rem;background:var(--card, #fffdf9);color:var(--card-foreground, #342b27);box-shadow:0 0 0 1px color-mix(in srgb,var(--foreground, #342b27) 10%,transparent);font-family:system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:.875rem}.ds-card-title{padding:0 1rem;font-size:1rem;font-weight:500;line-height:1.375}.ds-card-content{padding:0 1rem}@media(prefers-reduced-motion:reduce){.ds-card{transition-duration:0s}}"
